// =============================================================================
// Brush.compute
// -----------------------------------------------------------------------------
// Purpose : Paints a soft round blob onto a cube-sphere field. Every tool
//           (watering can, compost, heat, meteor...) works by adding to fields
//           with these kernels, so tools never touch creatures directly.
//
// Kernels :
//   BrushAdd - adds a soft blob to chosen channels of one field.
//   Crater   - a meteor impact: digs a bowl into the terrain, raises a rim, and
//              throws a ring of organic matter onto the soil around it.
//
// Idea    : The brush is a point on the sphere (a direction) with an angular
//           radius. Each texel asks "how far is my centre direction from the
//           brush centre?" and adds an amount that fades smoothly to zero at
//           the brush radius. Distance is measured as an ANGLE between two
//           directions, so:
//             - it is the same on every face and in every orientation,
//             - it needs no knowledge of face edges: a blob centred on a seam
//               or on one of the 8 cube corners simply lights up texels on
//               each face it reaches. That is what makes it seam-safe.
//
// Equations (c = brush direction, d = texel centre direction, R = radius):
//     angle  = acos( clamp(dot(d, c), -1, 1) )
//     weight = 1 - smoothstep(0, R, angle)        1 at the centre, 0 at R
//     value  = value + amount * weight            (per channel)
//     Channels whose amount is 0 are left untouched; the others are then
//     clamped to [_ClampRange.x, _ClampRange.y].
//
// Parameters:
//   _BrushDirection     - unit vector, brush centre in the PLANET's local space
//   _BrushAngularRadius - R, radians (world radius / planet radius)
//   _BrushAmount        - per-channel amount added at the centre
//   _ClampRange         - allowed (min, max) of a painted channel
//   _Resolution         - texels along one face edge
//
// Buffers & textures:
//   _Target - RWTexture2DArray<float4>, 6 slices, read and written in place.
//             In-place is safe: each thread touches only its own texel.
// =============================================================================

#pragma kernel BrushAdd
#pragma kernel Crater

#include "Assets/Shaders/Include/CubeSphere.hlsl"

RWTexture2DArray<float4> _Target;
int _Resolution;
float3 _BrushDirection;
float _BrushAngularRadius;
float4 _BrushAmount;
float2 _ClampRange;

[numthreads(8, 8, 1)]
void BrushAdd(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_Resolution || id.y >= (uint)_Resolution)
    {
        return;
    }

    float3 direction = CS_TexelCentreDir(int3(id), _Resolution);
    float angle = acos(clamp(dot(direction, _BrushDirection), -1.0, 1.0));
    float weight = 1.0 - smoothstep(0.0, _BrushAngularRadius, angle);

    if (weight <= 0.0)
    {
        return;
    }

    float4 before = _Target[id];
    float4 painted = clamp(before + _BrushAmount * weight, _ClampRange.x, _ClampRange.y);
    bool4 touched = _BrushAmount != 0.0;

    _Target[id] = touched ? painted : before;
}

// ---- Crater ---------------------------------------------------------------------
// Idea    : An impact digs a bowl, piles a rim of thrown-out rock around it, and scatters
//           broken material (organic matter) on the ground just outside.
// Equations (angle = angular distance from the impact, R = crater radius):
//     bowl   = (1 - (angle / R)^2)  for angle < R, else 0            deepest at the centre
//     rim    = exp( -((angle - R) / (0.25 R))^2 )  for angle > 0.9 R  a ridge at the edge
//     height = clamp( height - depth * bowl + rimHeight * rim, -1, 1 )
//     ring   = smoothstep(0.7 R, R, angle) * (1 - smoothstep(R, 1.8 R, angle))
//     organic matter += organicAmount * ring
//     A crater cut below sea level (height < 0) becomes a crater lake, because the planet
//     counts ground below zero as water.
// Parameters: _BrushDirection, _BrushAngularRadius (R), _CraterDepth, _CraterRim, _CraterOrganic.
// Textures  : _CraterTerrain (R height) and _CraterSoil (G organic), both read and written in place.

RWTexture2DArray<float4> _CraterTerrain;
RWTexture2DArray<float4> _CraterSoil;
float _CraterDepth;
float _CraterRim;
float _CraterOrganic;

[numthreads(8, 8, 1)]
void Crater(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_Resolution || id.y >= (uint)_Resolution)
    {
        return;
    }

    float3 direction = CS_TexelCentreDir(int3(id), _Resolution);
    float angle = acos(clamp(dot(direction, _BrushDirection), -1.0, 1.0));
    float radius = max(_BrushAngularRadius, 1e-4);

    if (angle > radius * 1.8)
    {
        return;
    }

    float ratio = angle / radius;
    float bowl = ratio < 1.0 ? 1.0 - ratio * ratio : 0.0;
    float rimDistance = (angle - radius) / (0.25 * radius);
    float rim = angle > 0.9 * radius ? exp(-rimDistance * rimDistance) : 0.0;

    float4 terrain = _CraterTerrain[id];
    terrain.r = clamp(terrain.r - _CraterDepth * bowl + _CraterRim * rim, -1.0, 1.0);
    _CraterTerrain[id] = terrain;

    float ring = smoothstep(0.7 * radius, radius, angle) * (1.0 - smoothstep(radius, 1.8 * radius, angle));
    float4 soil = _CraterSoil[id];
    soil.g += _CraterOrganic * ring;
    _CraterSoil[id] = soil;
}
