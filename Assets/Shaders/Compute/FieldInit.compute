// =============================================================================
// FieldInit.compute
// -----------------------------------------------------------------------------
// Purpose : Creates the starting contents of the cube-sphere fields: clearing,
//           carrying a field over to a new resolution, and generating terrain.
//
// Kernels :
//   Clear            - sets every channel of every texel to zero.
//   Resample4/1      - copies a field into one of a different resolution
//                      (4-channel / 1-channel), used when the quality preset changes.
//   TerrainRaw       - step 1 of terrain: raw noise height per texel + a histogram.
//   TerrainSeaLevel  - step 2: finds the sea level from the histogram (one thread).
//   TerrainFinalise  - step 3: turns raw height into final height around sea level.
//
// Idea (terrain): continents are 3D fractal noise sampled at each texel's
//   direction on the sphere. Because the noise lives in 3D space and the sphere
//   just cuts through it, there are no seams and no pole distortion. Mountain
//   chains are added with ridged noise, only where the ground is already high.
//
//   The user chooses a LAND FRACTION (say 38% land). Noise does not come with a
//   known distribution, so instead of guessing a threshold we measure it, on the
//   GPU, with no readback:
//     1. TerrainRaw writes each texel's raw value and counts it into one of
//        1024 histogram bins (InterlockedAdd makes the shared counting safe).
//     2. TerrainSeaLevel walks the histogram from the highest bin down until it
//        has passed landFraction of all texels. That bin's value is sea level.
//     3. TerrainFinalise subtracts sea level and scales, so height 0 is the
//        shoreline, land runs 0..1 and sea floor 0..-1.
//
// Equations:
//   raw    = Fbm(d * f + offset) + ridgeAmount * RidgedFbm(d * fr + offset)^ridgeSharpness * smoothstep(0.45, 0.65, Fbm)
//            (the power narrows the crests, so mountain chains are sharp ridges, not broad swells)
//   bin    = floor( raw / HISTOGRAM_RANGE * 1024 )
//   sea    = raw value of the bin where the top-down running count reaches landFraction * total
//   s      = (raw - sea) / reliefSpan
//   height = max(s, -1)                                                  for the sea floor
//   height = saturate(s)^(1 + mountainSharpness) + cragAmount * (ridged(d * cragFrequency) - 0.45) * smoothstep(0.25, 0.65, .)
//            for land: lowlands stay flat and low, peaks stay high, and the high ground is roughened into crags
//   hardness (G channel) = separate low-frequency noise, 0..1 (how rock-like the ground is)
//
// Parameters:
//   _Resolution        texels along one face edge
//   _SourceResolution  (Resample) resolution of the field being copied from
//   _SeedOffset        shifts the noise; derived from the world seed on the CPU
//   _ContinentFrequency (f), _TerrainOctaves, _RidgeFrequency (fr), _RidgeAmount, _RidgeSharpness,
//   _MountainSharpness, _CragAmount, _CragFrequency
//   _LandFraction      0..1, share of the surface above sea level
//   _ReliefSpan        raw-noise distance that maps to a height of 1
//
// Buffers & textures:
//   _Target            RWTexture2DArray<float4>, 6 slices, written (Clear, Terrain*)
//   _Source4/_Target4, _Source1/_Target1   Resample source (read) and target (written)
//   _Histogram         RWStructuredBuffer<uint>[1024], must be zeroed before TerrainRaw
//   _SeaLevel          RWStructuredBuffer<float>[1], written by TerrainSeaLevel,
//                      read by TerrainFinalise
// =============================================================================

#pragma kernel Clear
#pragma kernel Resample4
#pragma kernel Resample1
#pragma kernel TerrainRaw
#pragma kernel TerrainSeaLevel
#pragma kernel TerrainFinalise

#include "Assets/Shaders/Include/CubeSphere.hlsl"
#include "Assets/Shaders/Include/Noise.hlsl"

#define HISTOGRAM_BINS 1024
#define HISTOGRAM_RANGE 2.0

RWTexture2DArray<float4> _Target;
int _Resolution;

Texture2DArray<float4> _Source4;
RWTexture2DArray<float4> _Target4;
Texture2DArray<float> _Source1;
RWTexture2DArray<float> _Target1;
int _SourceResolution;

float3 _SeedOffset;
float _ContinentFrequency;
int _TerrainOctaves;
float _RidgeFrequency;
float _RidgeAmount;
float _RidgeSharpness;
float _MountainSharpness;
float _CragAmount;
float _CragFrequency;
float _LandFraction;
float _ReliefSpan;

RWStructuredBuffer<uint> _Histogram;
RWStructuredBuffer<float> _SeaLevel;

CS_DEFINE_SAMPLER(CS_SampleField4, Texture2DArray<float4>, float4)
CS_DEFINE_SAMPLER(CS_SampleField1, Texture2DArray<float>, float)

bool OutsideField(uint3 id)
{
    return id.x >= (uint)_Resolution || id.y >= (uint)_Resolution;
}

[numthreads(8, 8, 1)]
void Clear(uint3 id : SV_DispatchThreadID)
{
    if (OutsideField(id))
    {
        return;
    }

    _Target[id] = float4(0.0, 0.0, 0.0, 0.0);
}

// Resample4 / Resample1: for each texel of the NEW field, look up the OLD field at that texel's
// direction with the seam-correct bilinear sampler. Used when the quality preset changes the field
// resolution, so painted and simulated state carries over instead of being thrown away.
// (Going to a coarser grid samples rather than averages, so detail finer than a texel is lost.)
[numthreads(8, 8, 1)]
void Resample4(uint3 id : SV_DispatchThreadID)
{
    if (OutsideField(id))
    {
        return;
    }

    float3 direction = CS_TexelCentreDir(int3(id), _Resolution);
    _Target4[id] = CS_SampleField4(_Source4, direction, _SourceResolution);
}

[numthreads(8, 8, 1)]
void Resample1(uint3 id : SV_DispatchThreadID)
{
    if (OutsideField(id))
    {
        return;
    }

    float3 direction = CS_TexelCentreDir(int3(id), _Resolution);
    _Target1[id] = CS_SampleField1(_Source1, direction, _SourceResolution);
}

// Step 1: raw noise height into R, rock hardness into G, and count R into the histogram.
[numthreads(8, 8, 1)]
void TerrainRaw(uint3 id : SV_DispatchThreadID)
{
    if (OutsideField(id))
    {
        return;
    }

    float3 direction = CS_TexelCentreDir(int3(id), _Resolution);

    float continents = Fbm(direction * _ContinentFrequency + _SeedOffset, _TerrainOctaves);
    float ridges = pow(RidgedFbm(direction * _RidgeFrequency + _SeedOffset.zxy, 5), _RidgeSharpness);
    float raw = continents + _RidgeAmount * ridges * smoothstep(0.45, 0.65, continents);

    float hardness = Fbm(direction * (_ContinentFrequency * 2.3) + _SeedOffset.yzx, 3);

    _Target[id] = float4(raw, hardness, 0.0, 0.0);

    uint bin = (uint)clamp(raw / HISTOGRAM_RANGE * HISTOGRAM_BINS, 0.0, HISTOGRAM_BINS - 1.0);
    InterlockedAdd(_Histogram[bin], 1u);
}

// Step 2: one thread walks the histogram from the top to find the sea level.
[numthreads(1, 1, 1)]
void TerrainSeaLevel(uint3 id : SV_DispatchThreadID)
{
    uint total = (uint)(_Resolution * _Resolution * 6);
    uint wanted = (uint)(saturate(_LandFraction) * total);

    uint count = 0u;
    int bin = HISTOGRAM_BINS - 1;
    while (bin > 0 && count < wanted)
    {
        count += _Histogram[bin];
        bin--;
    }

    // `bin` is now the first bin BELOW the land; its upper edge is the shoreline.
    _SeaLevel[0] = (bin + 1.0) / HISTOGRAM_BINS * HISTOGRAM_RANGE;
}

// Step 3: final height. 0 = shoreline, 0..1 land, -1..0 sea floor.
[numthreads(8, 8, 1)]
void TerrainFinalise(uint3 id : SV_DispatchThreadID)
{
    if (OutsideField(id))
    {
        return;
    }

    float4 value = _Target[id];
    float scaled = (value.r - _SeaLevel[0]) / _ReliefSpan;

    float height;
    if (scaled <= 0.0)
    {
        height = max(scaled, -1.0);
    }
    else
    {
        // Land: raise the shape to a power above 1 so lowlands stay low and flat while the peaks stay high, then
        // roughen the high ground with a fine ridged term so mountains get crags instead of smooth domes.
        float land = pow(saturate(scaled), 1.0 + _MountainSharpness);
        float3 direction = CS_TexelCentreDir(int3(id), _Resolution);
        float crags = RidgedFbm(direction * _CragFrequency + _SeedOffset.yxz, 3);
        land += _CragAmount * (crags - 0.45) * smoothstep(0.25, 0.65, land);
        height = clamp(land, 0.0005, 1.0);
    }

    _Target[id] = float4(height, value.g, 0.0, 0.0);
}
