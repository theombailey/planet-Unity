// =============================================================================
// Physarum.compute
// -----------------------------------------------------------------------------
// Purpose : The planet's people. Each agent is a walker who follows, and lays, a
//           footpath; the paths that many walkers use become roads, and where roads
//           meet on good land, towns grow (Settlement.compute). After Jeff Jones'
//           agent model of Physarum polycephalum, the same rule that lets a slime mould
//           link food sources with an efficient network (Tero et al., 2010, rebuilt the
//           Tokyo rail map this way).
//
// Kernels :
//   InitAgents       - scatters the starting population on livable land.
//   CopyAgents       - carries agents into a re-sized pool (quality preset change).
//   ClearCounters    - zeroes the population counters before a step.
//   AgentStep        - one step of every agent: sense, steer, move, leave a path, earn
//                      food, pay upkeep, die or split.
//   TrailDiffuse     - adds this step's deposits to the trail, blurs it, fades it.
//   ClearDeposit     - zeroes the deposit buffer.
//   SpawnAgents      - settlers: starts agents inside a small circle (a tool), or at random
//                      empty livable places (pioneers drifting in).
//   KillAgents       - an impact: removes every agent inside a circle.
//
// Idea (the three rules that grow a network):
//   1. SENSE  Each agent samples a "signal" at three points ahead of it: straight on, and
//             left and right of that, at a fixed distance.
//   2. STEER  It turns toward the strongest signal.
//   3. LEAVE  It moves forward and adds a little path where it lands.
//   The path is part of the signal, so walkers follow paths that others (and they themselves)
//   laid. A path that is followed gets stronger, so it is followed more: positive feedback.
//   Meanwhile it blurs and fades, so unused paths vanish. The result is a web of roads
//   joining the places people want to be, with nobody drawing it.
//   Here the signal also includes LIVABILITY (good ground: warm, wet, low, fertile; see
//   Livability.hlsl), existing TOWNS and permanent ROADS, and the OCEAN is strongly repulsive.
//
// Geometry on the sphere (pos is a unit vector, heading a unit vector at right angles to it):
//   rotate heading about pos by angle a:   h' = h cos a + (pos x h) sin a
//   look ahead by arc s at angle a:        p  = normalize( pos cos s + h' sin s )
//   move by arc s:                         pos'     = normalize( pos cos s + h sin s )
//                                          heading' = -pos sin s + h cos s      (parallel transport)
//   then re-orthogonalise: heading' -= pos' (pos' . heading'), normalise.
//   Agents live in the planet's own frame, the same frame as the fields, so the spin of the
//   planet does not matter here.
//
// Energy (per step of dt seconds; all rates per sim second; L = livability here, C = crowding (how many
//   people are here now), S = town density (long memory), F = farmland 0..1 here, all from the Land field):
//   income   = foodRate * L * (1 + farmBoost * F) / (1 + C / (capacityBase + capacityFarm * F))
//   energy  += (income - upkeep) * dt
//   energy  -= oceanPenalty * dt                  if the agent is over ocean
//   energy <= 0              -> dies
//   energy >  reproduceEnergy -> splits: both halves keep (energy - birthCost) / 2
//   Farms feed more people (the boost and the higher capacity); crowding feeds fewer. A town
//   therefore grows until the land around it can hold no more. Population is never set by
//   script: it settles where income balances upkeep.
//   Walking slows in town: speed = speed * lerp(1, townSlowdown, saturate(S / townFull)), so
//   people crowd and potter about instead of racing through; and quickens on a permanent road (P, 0..1):
//   speed = speed * (1 + roadSpeedBoost * P).
//
// Concurrency (many agents act in the same moment; what is racy and why that is acceptable):
//   - Path deposits are added with InterlockedAdd into a per-texel integer buffer (fixed
//     point), so no deposit is ever lost. They are applied after the step (TrailDiffuse here,
//     LandStep in Settlement.compute).
//   - A new agent takes a dead slot picked at random, claimed with InterlockedCompareExchange
//     (0 dead -> 2 newborn). If that slot is taken the split simply waits for a later step. A
//     newborn (state 2) is switched to alive (1) at the start of the next step, so it is never
//     processed while its parent is still writing it.
//
// Agent buffers (one element per pool slot):
//   _PosEnergy  float4   xyz position (unit vector, planet frame), w energy
//   _Heading    float4   xyz heading (unit, tangent), w unused
//   _Alive      uint     0 dead, 1 alive, 2 newborn
//
// Parameters: see the variables below; they come from SimConfig "People".
// =============================================================================

#pragma kernel InitAgents
#pragma kernel CopyAgents
#pragma kernel ClearCounters
#pragma kernel AgentStep
#pragma kernel TrailDiffuse
#pragma kernel ClearDeposit
#pragma kernel SpawnAgents
#pragma kernel KillAgents

#include "Assets/Shaders/Include/CubeSphere.hlsl"
#include "Assets/Shaders/Include/Noise.hlsl"
#include "Assets/Shaders/Include/Livability.hlsl"

#define DEPOSIT_SCALE 4096.0

RWStructuredBuffer<float4> _PosEnergy;
RWStructuredBuffer<float4> _Heading;
RWStructuredBuffer<uint> _Alive;
RWStructuredBuffer<float4> _OldPosEnergy;       // CopyAgents source
RWStructuredBuffer<float4> _OldHeading;
RWStructuredBuffer<uint> _OldAlive;

RWStructuredBuffer<uint> _Deposit;              // per texel, fixed point (DEPOSIT_SCALE)
RWStructuredBuffer<uint> _Counters;             // [0] alive, [1] births, [2] deaths

Texture2DArray<float> _TrailRead;
RWTexture2DArray<float> _TrailWrite;
Texture2DArray<float4> _Land;                   // R town density, G farmland, B crowding, A permanent road
Texture2DArray<float> _Water;                   // proximity to water
Texture2DArray<float4> _Soil;                   // R nutrients
Texture2DArray<float4> _Terrain;                // R height
Texture2DArray<float4> _Climate;                // R temperature, G moisture

uint _PoolSize;
uint _OldPoolSize;
uint _StartAgents;
uint _Frame;
int _Resolution;
uint _ClearCount;
float _DeltaTime;
float _Seed;

float _SensorAngle;
float _SensorDistance;
float _TurnSpeed;
float _Speed;
float _DepositAmount;
float _TrailDiffusion;
float _TrailDecay;
float _TrailMax;
float _FoodWeight;
float _TownWeight;
float _FoodRate;
float _Upkeep;
float _StartEnergy;
float _ReproduceEnergy;
float _BirthCost;
float _OceanPenalty;
float _FarmBoost;
float _CapacityBase;
float _CapacityFarm;
float _TownSlowdown;
float _TownFull;
float _RoadWeight;
float _RoadSpeed;

float3 _EventDirection;      // SpawnAgents / KillAgents: centre of the circle (unit vector, planet frame)
float _EventRadius;          // ... and its radius in radians
uint _SpawnCount;
uint _SpawnAnywhere;         // 1: pioneers pick their own empty livable spot anywhere; 0: inside the circle

static const float OCEAN_AVOIDANCE = 50.0;      // signal penalty for ocean: people never choose to go there

// ---- small helpers ----------------------------------------------------------------

float Random01(inout uint state)
{
    state = HashUint(state);
    return (state >> 8) * (1.0 / 16777216.0);
}

float3 RotateAbout(float3 position, float3 heading, float angle)
{
    float s, c;
    sincos(angle, s, c);
    return heading * c + cross(position, heading) * s;
}

// Point `distance` radians away from `position` in the direction `heading`.
float3 Ahead(float3 position, float3 heading, float distance)
{
    float s, c;
    sincos(distance, s, c);
    return normalize(position * c + heading * s);
}

uint TexelIndex(int3 texel)
{
    return (uint)((texel.z * _Resolution + texel.y) * _Resolution + texel.x);
}

// Livability of the ground at a texel (0 in the ocean).
float LivabilityAt(uint3 texel)
{
    float height = _Terrain[texel].r;
    if (height < 0.0)
    {
        return 0.0;
    }

    float4 climate = _Climate[texel];
    return Livability(climate.r, IrrigatedMoisture(climate.g, _Water[texel]), height, _Soil[texel].r);
}

// The strength of the signal at a point: path + good ground + towns, minus a huge penalty over ocean.
float Signal(float3 location)
{
    uint3 texel = uint3(CS_DirToTexel(location, _Resolution));
    if (_Terrain[texel].r < 0.0)
    {
        return -OCEAN_AVOIDANCE;
    }

    float4 land = _Land[texel];
    return _TrailRead[texel] + _FoodWeight * LivabilityAt(texel) + _TownWeight * saturate(land.r) + _RoadWeight * saturate(land.a);
}

// Random unit vector on the sphere.
float3 RandomDirection(inout uint state)
{
    float z = Random01(state) * 2.0 - 1.0;
    float phi = Random01(state) * 6.28318530718;
    float r = sqrt(saturate(1.0 - z * z));
    return float3(r * cos(phi), z, r * sin(phi));
}

// Random unit vector at right angles to `position`.
float3 RandomHeading(float3 position, inout uint state)
{
    float3 reference = abs(position.y) < 0.99 ? float3(0, 1, 0) : float3(1, 0, 0);
    float3 t1 = normalize(cross(position, reference));
    float3 t2 = cross(position, t1);
    float angle = Random01(state) * 6.28318530718;
    return t1 * cos(angle) + t2 * sin(angle);
}

// ---- kernels ----------------------------------------------------------------------

[numthreads(64, 1, 1)]
void InitAgents(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    if (index >= _PoolSize)
    {
        return;
    }

    _Alive[index] = 0u;
    _PosEnergy[index] = float4(0, 1, 0, 0);
    _Heading[index] = float4(1, 0, 0, 0);

    if (index >= _StartAgents)
    {
        return;
    }

    // Try a few random spots until one is livable land.
    uint state = HashUint(index * 2654435761u + asuint(_Seed) + 12345u);
    for (int attempt = 0; attempt < 24; attempt++)
    {
        float3 direction = RandomDirection(state);
        uint3 texel = uint3(CS_DirToTexel(direction, _Resolution));
        if (LivabilityAt(texel) > 0.3)
        {
            _PosEnergy[index] = float4(direction, _StartEnergy);
            _Heading[index] = float4(RandomHeading(direction, state), 0.0);
            _Alive[index] = 1u;
            return;
        }
    }
}

[numthreads(64, 1, 1)]
void CopyAgents(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    if (index >= _PoolSize)
    {
        return;
    }

    bool exists = index < _OldPoolSize;
    _Alive[index] = exists ? _OldAlive[index] : 0u;
    _PosEnergy[index] = exists ? _OldPosEnergy[index] : float4(0, 1, 0, 0);
    _Heading[index] = exists ? _OldHeading[index] : float4(1, 0, 0, 0);
}

[numthreads(1, 1, 1)]
void ClearCounters(uint3 id : SV_DispatchThreadID)
{
    _Counters[0] = 0u;
    _Counters[1] = 0u;
    _Counters[2] = 0u;
}

[numthreads(64, 1, 1)]
void AgentStep(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    if (index >= _PoolSize)
    {
        return;
    }

    uint life = _Alive[index];
    if (life == 0u)
    {
        return;
    }

    if (life == 2u)
    {
        _Alive[index] = 1u;   // a newborn joins in from the next step
        return;
    }

    uint rng = HashUint(index ^ (_Frame * 747796405u + 2891336453u));

    float4 body = _PosEnergy[index];
    float3 position = body.xyz;
    float3 heading = _Heading[index].xyz;
    float energy = body.w;

    // 1. SENSE: three points ahead, at -angle, 0, +angle from the heading.
    float centre = Signal(Ahead(position, heading, _SensorDistance));
    float left = Signal(Ahead(position, RotateAbout(position, heading, _SensorAngle), _SensorDistance));
    float right = Signal(Ahead(position, RotateAbout(position, heading, -_SensorAngle), _SensorDistance));

    // 2. STEER (Jones' rule).
    float turn = 0.0;
    if (centre > left && centre > right)
    {
        turn = 0.0;                                             // straight ahead is best
    }
    else if (centre < left && centre < right)
    {
        turn = (Random01(rng) < 0.5 ? -1.0 : 1.0) * _TurnSpeed * _DeltaTime;   // both sides better: pick one
    }
    else if (left > right)
    {
        turn = _TurnSpeed * _DeltaTime;
    }
    else if (right > left)
    {
        turn = -_TurnSpeed * _DeltaTime;
    }

    heading = RotateAbout(position, heading, turn);

    // 3. MOVE along the sphere and carry the heading with us. People slow down in a town.
    float4 landHere = _Land[uint3(CS_DirToTexel(position, _Resolution))];
    float arc = _Speed * lerp(1.0, _TownSlowdown, saturate(landHere.r / _TownFull)) * (1.0 + _RoadSpeed * saturate(landHere.a)) * _DeltaTime;
    float s, c;
    sincos(arc, s, c);
    float3 newPosition = normalize(position * c + heading * s);
    float3 newHeading = -position * s + heading * c;
    newHeading = normalize(newHeading - newPosition * dot(newPosition, newHeading));

    if (any(isnan(newPosition)) || any(isnan(newHeading)))
    {
        _Alive[index] = 0u;                                     // a corrupt agent is removed
        return;
    }

    int3 texel = CS_DirToTexel(newPosition, _Resolution);
    uint3 texelIndex3 = uint3(texel);
    uint texelIndex = TexelIndex(texel);

    // 4. LEAVE a path.
    InterlockedAdd(_Deposit[texelIndex], (uint)(_DepositAmount * DEPOSIT_SCALE));

    // 5. EARN food and pay the costs of living.
    float4 land = _Land[texelIndex3];
    float capacity = _CapacityBase + _CapacityFarm * land.g;
    float income = _FoodRate * LivabilityAt(texelIndex3) * (1.0 + _FarmBoost * land.g) / (1.0 + land.b / capacity);
    energy += (income - _Upkeep) * _DeltaTime;

    if (_Terrain[texelIndex3].r < 0.0)
    {
        energy -= _OceanPenalty * _DeltaTime;
    }

    // 6. LIFE CYCLE.
    if (energy <= 0.0)
    {
        _Alive[index] = 0u;
        InterlockedAdd(_Counters[2], 1u);
        return;
    }

    if (energy > _ReproduceEnergy)
    {
        uint slot = HashUint(index * 2654435761u + _Frame) % _PoolSize;
        uint previous;
        InterlockedCompareExchange(_Alive[slot], 0u, 2u, previous);

        if (previous == 0u)
        {
            float share = (energy - _BirthCost) * 0.5;
            float3 childHeading = RotateAbout(newPosition, newHeading, (Random01(rng) - 0.5) * 2.0);
            _PosEnergy[slot] = float4(newPosition, share);
            _Heading[slot] = float4(childHeading, 0.0);
            energy = share;
            InterlockedAdd(_Counters[1], 1u);
        }
    }

    _PosEnergy[index] = float4(newPosition, energy);
    _Heading[index] = float4(newHeading, 0.0);
    InterlockedAdd(_Counters[0], 1u);
}

// Adds this step's deposits to the trail, blurs it over the 3x3 neighbourhood (seam-aware), and fades it.
[numthreads(8, 8, 1)]
void TrailDiffuse(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_Resolution || id.y >= (uint)_Resolution)
    {
        return;
    }

    int3 texel = int3(id);
    float centre = _TrailRead[id] + _Deposit[TexelIndex(texel)] * (1.0 / DEPOSIT_SCALE);
    float sum = centre;

    for (int dy = -1; dy <= 1; dy++)
    {
        for (int dx = -1; dx <= 1; dx++)
        {
            if (dx == 0 && dy == 0)
            {
                continue;
            }

            int3 neighbour = CS_NeighbourTexel(texel, int2(dx, dy), _Resolution);
            sum += _TrailRead[uint3(neighbour)] + _Deposit[TexelIndex(neighbour)] * (1.0 / DEPOSIT_SCALE);
        }
    }

    float blurred = lerp(centre, sum / 9.0, _TrailDiffusion);
    _TrailWrite[id] = clamp(blurred * (1.0 - _TrailDecay * _DeltaTime), 0.0, _TrailMax);
}

[numthreads(64, 1, 1)]
void ClearDeposit(uint3 id : SV_DispatchThreadID)
{
    if (id.x < _ClearCount)
    {
        _Deposit[id.x] = 0u;
    }
}

// Settlers: each thread starts one person in a random dead slot, claimed with the same compare-exchange
// used for births. If the slot is taken the settler is simply lost.
//   _SpawnAnywhere = 0 (a tool): at a random point inside the circle, wherever it is.
//   _SpawnAnywhere = 1 (pioneers): the thread tries a few random places on the planet and settles at the first
//   that is good, empty ground, so new people found new villages instead of piling into old ones.
[numthreads(64, 1, 1)]
void SpawnAgents(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _SpawnCount)
    {
        return;
    }

    uint rng = HashUint(id.x * 2654435761u + _Frame * 747796405u + 977u);

    float3 position = float3(0, 1, 0);
    if (_SpawnAnywhere != 0u)
    {
        bool found = false;
        for (int attempt = 0; attempt < 8 && !found; attempt++)
        {
            float3 candidate = RandomDirection(rng);
            uint3 texel = uint3(CS_DirToTexel(candidate, _Resolution));
            if (LivabilityAt(texel) > 0.35 && _Land[texel].r < 0.05)
            {
                position = candidate;
                found = true;
            }
        }

        if (!found)
        {
            return;
        }
    }
    else
    {
        // A uniform random point in the circle: the distance is radius * sqrt(u), the direction is random.
        float3 outward = RandomHeading(_EventDirection, rng);
        float distance = _EventRadius * sqrt(Random01(rng));
        position = Ahead(_EventDirection, outward, distance);
    }

    uint slot = HashUint(rng) % _PoolSize;
    uint previous;
    InterlockedCompareExchange(_Alive[slot], 0u, 2u, previous);
    if (previous != 0u)
    {
        return;
    }

    _PosEnergy[slot] = float4(position, _StartEnergy);
    _Heading[slot] = float4(RandomHeading(position, rng), 0.0);
    InterlockedAdd(_Counters[1], 1u);
}

// An impact: every living person within the circle dies.
[numthreads(64, 1, 1)]
void KillAgents(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    if (index >= _PoolSize || _Alive[index] == 0u)
    {
        return;
    }

    float3 position = _PosEnergy[index].xyz;
    float angle = acos(clamp(dot(position, _EventDirection), -1.0, 1.0));
    if (angle > _EventRadius)
    {
        return;
    }

    _Alive[index] = 0u;
    InterlockedAdd(_Counters[2], 1u);
}
